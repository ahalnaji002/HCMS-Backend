PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hcms_db

JWT_SECRET=
JWT_EXPIRES_IN=1h

ADMIN_EMAIL=admin@hcms.local
ADMIN_PASSWORD=

TEST_DB_HOST=localhost
TEST_DB_PORT=3306
TEST_DB_USER=root
TEST_DB_PASSWORD=
TEST_DB_NAME=hcms_test_db

# Comma-separated frontend origins allowed by CORS.
# Leave empty to allow only the local development origins.
CORS_ORIGIN=

# Set to the number of reverse-proxy hops in production (e.g. 1).
TRUST_PROXY=

# Optional rate-limit overrides (defaults shown in docs/api/README.md).
RATE_LIMIT_EMERGENCY_MAX=
RATE_LIMIT_LOGIN_MAX=
RATE_LIMIT_REGISTER_MAX=
