{
  "name": "hcms-backend",
  "version": "1.0.0",
  "description": "Backend API for the Healthcare Conflict Management System (HCMS)",
  "main": "index.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node scripts/runIsolatedTests.js",
    "test:coverage": "node scripts/runIsolatedTests.js --experimental-test-coverage --test-coverage-include=src/**/*.js --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=90",
    "migrate": "knex migrate:latest --env development",
    "migrate:rollback": "knex migrate:rollback --env development",
    "seed": "knex seed:run --env development",
    "seed:demo": "node scripts/seedDemoData.js",
    "docs:build": "node scripts/buildOpenApi.js && node scripts/buildPostmanCollection.js",
    "docs:check": "node scripts/buildOpenApi.js --check && node scripts/buildPostmanCollection.js --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahalnaji002/HCMS-Backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ahalnaji002/HCMS-Backend/issues"
  },
  "homepage": "https://github.com/ahalnaji002/HCMS-Backend#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "mysql2": "^3.24.6",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2",
    "swagger-jsdoc": "^6.3.0"
  }
}
